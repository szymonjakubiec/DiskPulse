<Window x:Class="DiskPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiskPulse.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>
        
        <Grid Grid.Column="0" VerticalAlignment="Top">
            <StackPanel>
                <Button Content="Local Disk (C:)" Height="40"
                        Command="{Binding ExecuteActionCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"
                        Tag="C:\" />

                <Button Content="Local Disk (D:)" Height="40"
                        Command="{Binding ExecuteActionCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"
                        Tag="D:\" />

                <Button Content="Desktop" Height="40"
                        Command="{Binding ExecuteActionCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"
                        Tag="C:\Users\[Username]\Desktop" />
            </StackPanel>
            
        </Grid>
        <Grid Grid.Column="1">
            <StackPanel>
                <TextBlock Text="{Binding ExampleMessage, UpdateSourceTrigger=PropertyChanged}"
                           Height="Auto" />

                <Border Height="1"
                        Background="Black" />

                <Border Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <TextBlock Text="Utilization history"
                               FontWeight="Bold"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               TextAlignment="Center" />
                </Border>
            </StackPanel>
        </Grid>
        <Border Grid.Column="0"
                Width="2"
                HorizontalAlignment="Right"
                Background="Gray" />
    </Grid>
</Window>
